// ============================================================================
// Module 06 — Cart, Checkout & Orders
// (defines the shared `outbox` table reused by all event-publishing modules)
// ============================================================================

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  ACCEPTED
  READY
  DISPATCHED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum OrderStrategy {
  SINGLE
  SPLIT
}

enum OrderLineStatus {
  PENDING
  RESERVED
  ACCEPTED
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
  SUBSTITUTED
}

enum FulfillmentStatus {
  PENDING
  ACCEPTED
  PREPARING
  READY
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Cart {
  id             String     @id @default(uuid())
  customerUserId String
  beneficiaryId  String?
  status         CartStatus @default(ACTIVE)
  updatedAt      DateTime   @updatedAt
  createdAt      DateTime   @default(now())

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String   @id @default(uuid())
  cartId           String
  catalogProductId String
  quantity         Int
  indicativePrice  Int?
  requiresRx       Boolean  @default(false)
  addedAt          DateTime @default(now())

  cart Cart @relation(fields: [cartId], references: [id])

  @@unique([cartId, catalogProductId])
  @@map("cart_items")
}

model Order {
  id                  String        @id @default(uuid())
  orderNumber         String        @unique
  customerUserId      String
  beneficiarySnapshot Json?
  addressSnapshot     Json?
  status              OrderStatus   @default(DRAFT)
  strategy            OrderStrategy @default(SINGLE)
  subtotal            Int           @default(0)
  deliveryFee         Int           @default(0)
  platformFee         Int           @default(0)
  discountTotal       Int           @default(0)
  grandTotal          Int           @default(0)
  currency            String        @default("ETB")
  paymentId           String?
  matchRequestId      String?
  deliverySlot        String?
  idempotencyKey      String        @unique
  isCod               Boolean       @default(false)
  placedAt            DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  lines         OrderLine[]
  fulfillments  Fulfillment[]
  statusHistory OrderStatusHistory[]
  invoice       Invoice?
  cancellationRequest OrderCancellationRequest?

  @@map("orders")
}

model OrderLine {
  id                       String          @id @default(uuid())
  orderId                  String
  catalogProductId         String
  productSnapshot          Json?
  quantity                 Int
  unitPrice                Int
  lineTotal                Int
  fulfillmentId            String?
  pharmacyId               String?
  branchId                 String?
  reservationId            String?
  prescriptionLineId       String?
  requiresRx               Boolean         @default(false)
  lineStatus               OrderLineStatus @default(PENDING)
  substitutedFromProductId String?
  createdAt                DateTime        @default(now())

  order       Order        @relation(fields: [orderId], references: [id])
  fulfillment Fulfillment? @relation(fields: [fulfillmentId], references: [id])

  @@map("order_lines")
}

model Fulfillment {
  id            String            @id @default(uuid())
  orderId       String
  pharmacyId    String
  branchId      String
  status        FulfillmentStatus @default(PENDING)
  deliveryJobId String?
  acceptedAt    DateTime?
  readyAt       DateTime?
  createdAt     DateTime          @default(now())

  order Order       @relation(fields: [orderId], references: [id])
  lines OrderLine[]

  @@map("fulfillments")
}

model OrderStatusHistory {
  id          String   @id @default(uuid())
  orderId     String
  fromStatus  String?
  toStatus    String
  event       String?
  actorUserId String?
  actorRole   String?
  reason      String?
  createdAt   DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("order_status_history")
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  pdfRef        String?
  totals        Json?
  issuedAt      DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@map("invoices")
}

// Shared reliable event-publishing table (outbox pattern) — used by all modules.
/// Durable workflow phase of a customer cancellation (Work 55). `orders.status` remains the only
/// source of truth for whether the order is cancelled; this records how far the cancellation saga
/// (release stock in Module 04 -> cancel the order -> reverse the coupon in Module 07) has got.
enum OrderCancellationPhase {
  /// Intent recorded; Module 04's all-or-nothing release not yet confirmed.
  REQUESTED
  /// Every reservation of the order is released (or was already).
  STOCK_RELEASED
  /// `orders.status = CANCELLED` committed (with history, audit, outbox); coupon reversal pending.
  ORDER_CANCELLED
  /// Coupon reversal done (or nothing to reverse). Terminal.
  COMPLETED
  /// Module 04 refused: a reservation had already been dispatched. Nothing changed. Terminal.
  REJECTED
}

/// Persisted customer-cancellation intent (Work 55). One per order: an order is cancelled at most
/// once and a dispatch rejection is irreversible, so a repeat request resumes (or reports) this row.
model OrderCancellationRequest {
  id                  String                 @id @default(uuid())
  orderId             String                 @unique
  /// The customer who asked — kept as the initiator even when recovery finishes the work.
  customerUserId      String
  reason              String
  phase               OrderCancellationPhase @default(REQUESTED)
  attempts            Int                    @default(0)
  /// Earliest time the reconciler may retry (exponential backoff after a transient failure).
  nextAttemptAt       DateTime               @default(now())
  /// Structured code of the last failure (an `ErrorCode`, a Prisma code, or `UNKNOWN`).
  lastErrorCode       String?
  lastErrorAt         DateTime?
  /// Set when a permanent failure needs an operator; the reconciler then leaves the row alone.
  attentionRequiredAt DateTime?
  /// Lease: only the executor holding an unexpired lease may advance the phase.
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  completedAt         DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([phase, nextAttemptAt])
  @@index([attentionRequiredAt])
  @@map("order_cancellation_requests")
}

model Outbox {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishedAt])
  @@map("outbox")
}
