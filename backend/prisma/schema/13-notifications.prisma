// ============================================================================
// Module 13 — Notifications & Communication
// (event-driven multi-channel delivery; template versioning; per-user prefs & quiet hours)
// ============================================================================

enum NotificationChannel {
  PUSH
  SMS
  EMAIL
  IN_APP
}

enum MessageCategory {
  TRANSACTIONAL
  REMINDER
  MARKETING
  SYSTEM
  SECURITY
}

enum DeliveryStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
  BOUNCED
  SUPPRESSED
  READ
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// Work 13: the current state of one notification's delivery on one external channel.
enum NotificationDeliveryJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  SUPPRESSED
  EXHAUSTED
}

enum DigestFrequency {
  IMMEDIATE
  HOURLY
  DAILY
  WEEKLY
}

model NotificationTemplate {
  id          String              @id @default(uuid())
  code        String
  version     Int                 @default(1)
  channel     NotificationChannel
  category    MessageCategory
  locale      String              @default("en")
  subject     String?
  body        String
  variables   Json?
  providerRef String?
  status      TemplateStatus      @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  notifications Notification[]

  @@unique([code, channel, locale, version])
  @@map("notification_templates")
}

model Notification {
  id              String              @id @default(uuid())
  recipientUserId String
  category        MessageCategory
  channel         NotificationChannel
  templateId      String?
  templateCode    String?
  eventType       String?
  dedupeKey       String?             @unique
  payload         Json?
  renderedTitle   String?
  renderedBody    String?
  status          DeliveryStatus      @default(QUEUED)
  scheduledFor    DateTime?
  priority        Int                 @default(5)
  createdAt       DateTime            @default(now())

  template     NotificationTemplate?     @relation(fields: [templateId], references: [id])
  attempts     DeliveryAttempt[]
  deliveryJobs NotificationDeliveryJob[]

  @@index([recipientUserId, createdAt])
  @@index([status, scheduledFor])
  @@map("notifications")
}

model DeliveryAttempt {
  id             String              @id @default(uuid())
  notificationId String
  attemptNumber  Int                 @default(1)
  channel        NotificationChannel
  provider       String?
  providerMsgId  String?
  status         DeliveryStatus
  errorCode      String?
  errorDetail    String?
  attemptedAt    DateTime            @default(now())

  notification Notification @relation(fields: [notificationId], references: [id])

  @@index([providerMsgId])
  @@map("delivery_attempts")
}

// Work 13: durable external-delivery work — one row per (notification, external channel), created
// with the in-app notification for each channel the user's preference allowed at that moment.
// `delivery_attempts` stays the immutable history; this row is the current state and the authority
// for the next attempt number. `leaseExpiresAt` is set while a dispatcher holds the job
// (PROCESSING) and doubles as the fencing token for its completion write. No contact data.
model NotificationDeliveryJob {
  id             String                        @id @default(uuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryJobStatus @default(PENDING)
  attemptCount   Int                           @default(0)
  nextAttemptAt  DateTime                      @default(now())
  leaseExpiresAt DateTime?
  lastErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime                      @default(now())
  updatedAt      DateTime                      @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id])

  @@unique([notificationId, channel])
  @@index([status, nextAttemptAt])
  @@map("notification_delivery_jobs")
}

// The single source of truth for notification preferences (Work 11): one row per (user, category,
// channel); an absent row means the column defaults. Owned by Module 13, which alone reads and
// writes it.
model ChannelPreference {
  id              String              @id @default(uuid())
  userId          String
  category        MessageCategory
  channel         NotificationChannel
  enabled         Boolean             @default(true)
  digestFrequency DigestFrequency     @default(IMMEDIATE)
  updatedAt       DateTime            @updatedAt

  @@unique([userId, category, channel])
  @@map("channel_preferences")
}

model QuietHours {
  id        String   @id @default(uuid())
  userId    String   @unique
  startTime String
  endTime   String
  timezone  String   @default("Africa/Addis_Ababa")
  updatedAt DateTime @updatedAt

  @@map("quiet_hours")
}

model DeviceToken {
  id         String    @id @default(uuid())
  userId     String
  token      String    @unique
  platform   String
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("device_tokens")
}

// Work 18: one row per provider webhook delivery already applied — its provider and event id
// (Resend: the `svix-id` header) and the event type, nothing of the payload. The unique key is what
// makes a redelivered or concurrent duplicate a no-op; the row is written in the same transaction
// as the event's effects, so a failed apply leaves no receipt and the provider's retry reprocesses.
model NotificationWebhookReceipt {
  id         String   @id @default(uuid())
  provider   String
  eventId    String
  eventType  String
  receivedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("notification_webhook_receipts")
}

// Work 18: for EMAIL, `address` holds `sha256:<hex>` of Module 01's canonical (lowercased) address —
// never the raw address; deterministic, so a send-time check matches a webhook-time suppression.
model SuppressionEntry {
  id        String              @id @default(uuid())
  channel   NotificationChannel
  address   String
  reason    String?
  createdAt DateTime            @default(now())

  @@unique([channel, address])
  @@map("suppression_list")
}

model InboundMessage {
  id            String              @id @default(uuid())
  channel       NotificationChannel
  fromAddress   String
  body          String?
  providerRef   String?
  matchedUserId String?
  receivedAt    DateTime            @default(now())

  @@map("inbound_messages")
}
