# PharmaLink backend — LOCAL staging rehearsal environment (placeholders only).
#
# Copy to backend/.env.staging (gitignored) and replace every value marked REPLACE_ME,
# or let the rehearsal script generate one:  node ops/staging/rehearse-clean-install.mjs --init-env
# Never commit the filled-in file. Never put production credentials or real API keys here.
#
# The variables the backend itself requires are validated at boot by
# src/shared/config/env.validation.ts; the app refuses to start if one is missing or invalid.
#
# DATABASE_URL, REDIS_URL, NODE_ENV and PORT are NOT set here: compose.staging.yml sets them so
# the backend can only reach the stack's own disposable PostgreSQL and Redis. Use
# BACKEND_HOST_PORT below to change the host-side port.

# ── Disposable PostgreSQL (compose service `postgres`) ─────────────────────────────────────
# Letters and digits only (it is embedded in the connection URL). Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=REPLACE_ME

# ── Required by the backend ────────────────────────────────────────────────────────────────
# At least 16 characters each, and different from each other. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME

# Base64 of exactly 32 random bytes (44 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=REPLACE_ME

# ── Optional (validated defaults apply when unset) ─────────────────────────────────────────
# Host port the backend is published on, bound to 127.0.0.1 only.
BACKEND_HOST_PORT=3000
# Comma-separated browser origins allowed by CORS (default http://localhost:5173).
# WEB_ORIGIN=http://localhost:5173
# Platform commission as a fraction (0.05 = 5%). Defaults to 0.
# ORDERS_PLATFORM_FEE_PERCENT=0
# Token and OTP lifetimes (defaults: 900 s, 30 days, 300 s, 5 attempts).
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=30
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# Delivery tuning (DELIVERY_*): see env.validation.ts for every name, default and bound.

# ── Integrations: leave unset for the rehearsal ────────────────────────────────────────────
# E-mail (Resend) and push (FCM) stay disabled while unset. Telebirr is deliberately
# unimplemented; do not enable it. Never put working provider keys in this file's copy unless
# you intend to send real messages from your machine.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_WEBHOOK_SECRET=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
