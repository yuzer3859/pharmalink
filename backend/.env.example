# PharmaLink backend — LOCAL staging rehearsal environment (placeholders only).
#
# Copy to backend/.env.staging (gitignored) and replace every value marked REPLACE_ME,
# or let the rehearsal script generate one:  node ops/staging/rehearse-clean-install.mjs --init-env
# Never commit the filled-in file. Never put production credentials or real API keys here.
#
# The variables the backend itself requires are validated at boot by
# src/shared/config/env.validation.ts; the app refuses to start if one is missing or invalid.
#
# DATABASE_URL, REDIS_URL, NODE_ENV, PORT and OTP_STORE are NOT set here: compose.staging.yml sets
# them so the backend can only reach the stack's own disposable PostgreSQL and Redis, and always
# keeps OTPs in that Redis. Use BACKEND_HOST_PORT below to change the host-side port.

# ── Disposable PostgreSQL (compose service `postgres`) ─────────────────────────────────────
# Letters and digits only (it is embedded in the connection URL). Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=REPLACE_ME

# ── Required by the backend ────────────────────────────────────────────────────────────────
# At least 16 characters each, and different from each other. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME

# Base64 of exactly 32 random bytes (44 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_ENCRYPTION_KEY=REPLACE_ME

# Keys the HMAC of every stored OTP code and identifier (backend/docs/otp-storage.md). This stack
# keeps OTPs in its own Redis: compose.staging.yml sets OTP_STORE=redis itself, so do not set
# OTP_STORE here. At least 32 random characters, local to this file, and not a copy of any secret
# above. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_HASH_SECRET=REPLACE_ME

# ── Optional (validated defaults apply when unset) ─────────────────────────────────────────
# Identity verification provider: `mock` or `fayda`. Unset means `mock` outside production, which
# is what this local stack (NODE_ENV=development) uses. `fayda` fails at startup until a real
# adapter exists. See backend/docs/runtime-identity-verification.md.
# IDENTITY_VERIFICATION_PROVIDER=mock
# Host port the backend is published on, bound to 127.0.0.1 only.
BACKEND_HOST_PORT=3000
# Comma-separated browser origins allowed by CORS (default http://localhost:5173).
# WEB_ORIGIN=http://localhost:5173
# Platform commission as a fraction (0.05 = 5%). Defaults to 0.
# ORDERS_PLATFORM_FEE_PERCENT=0
# Token lifetimes (defaults: 900 s, 30 days).
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_DAYS=30
# OTP lifetime, wrong attempts per code, and seconds between codes (defaults: 300, 5, 30).
# OTP_TTL_SECONDS=300
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=30
# Delivery tuning (DELIVERY_*): see env.validation.ts for every name, default and bound.

# HTTP security (see backend/docs/http-security.md). Defaults are safe for this local stack.
# Reverse proxies allowed to set X-Forwarded-*: their IPs/CIDRs, or loopback/linklocal/uniquelocal.
# Unset = trust none (correct here: there is no proxy). `true`, `*` and hop counts are rejected.
# TRUST_PROXY=
# Rate limits per client per route. The auth limit covers login, OTP, registration, token
# refresh, password recovery/reset/change and Fayda submission. No value disables them.
# RATE_LIMIT_AUTH_LIMIT=10
# RATE_LIMIT_AUTH_TTL_SECONDS=60
# RATE_LIMIT_DEFAULT_LIMIT=300
# RATE_LIMIT_DEFAULT_TTL_SECONDS=60
# Strict-Transport-Security max-age; 0 (default) sends none. Only behind HTTPS.
# HTTP_HSTS_MAX_AGE_SECONDS=0

# ── Integrations: leave unset for the rehearsal ────────────────────────────────────────────
# E-mail (Resend) and push (FCM) stay disabled while unset. Telebirr is deliberately
# unimplemented; do not enable it. Never put working provider keys in this file's copy unless
# you intend to send real messages from your machine.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# RESEND_WEBHOOK_SECRET=
# FCM_PROJECT_ID=
# FCM_CLIENT_EMAIL=
# FCM_PRIVATE_KEY=
